{
  "id": "mentor-polling",
  "version": "1.0.0",
  "description": "Paces mentor_get_run polls (45 s per run) and compacts their output before Claude reads it, plus a skill on how to poll and read Mentor runs.",
  "skills": ["mentor-polling"],
  "runtime": [
    "runtime/mentor/mentor-run-text.cjs",
    "runtime/mentor/mentor-poll-throttle.cjs",
    "runtime/mentor/mentor-get-run-filter.cjs"
  ],
  "hooks": {
    "PreToolUse": [
      { "matcher": "mcp__.*__mentor_get_run$", "script": "mentor-poll-throttle.cjs", "timeout": 60 }
    ],
    "PostToolUse": [
      { "matcher": "mcp__.*__mentor_get_run$", "script": "mentor-get-run-filter.cjs", "timeout": 10 }
    ]
  }
}
