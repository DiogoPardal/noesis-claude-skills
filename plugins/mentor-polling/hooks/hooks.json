{
  "description": "Paces mentor_get_run polls (45 s per run) and compacts their output before Claude reads it, plus a skill on how to poll and read Mentor runs.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__mentor_get_run$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/mentor-poll-throttle.cjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__mentor_get_run$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/mentor-get-run-filter.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
